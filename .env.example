# Discord webhook for arbitrage alerts (Server Settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=

# Total amount (in €) to split across the two legs of each arbitrage
TOTAL_STAKE=100

# Ignore arbs below this guaranteed profit percentage
MIN_PROFIT_PCT=0.5

# Seconds between scans when running continuously
POLL_INTERVAL_SECONDS=300

# Which competitions to scan (comma-separated). Default: all three.
# Useful during off-season, e.g. only the World Cup:
#COMPETITIONS=world_cup
COMPETITIONS=premier_league,la_liga,world_cup

# Odds sources.
#   BET365_PROVIDER: mock | file | selenium
#   UNIBET_PROVIDER: mock | kambi | file
BET365_PROVIDER=mock
UNIBET_PROVIDER=mock

# For the "file" provider: local JSON path or https URL (see data/sample_bet365.json)
BET365_DATA_FILE=
UNIBET_DATA_FILE=

# Selenium scraper settings (only for BET365_PROVIDER=selenium).
# Run from a residential IP; BET365_HEADLESS=0 (visible browser) is much less
# likely to be blocked. Install undetected-chromedriver for best results.
#BET365_BASE_URL=https://www.bet365.nl
#BET365_HEADLESS=0
#BET365_MAX_EVENTS=10
#BET365_CHROME_BINARY=
# Match pages to scrape (bet365's left-nav is obfuscated and match URLs are
# session-bound, so point the scraper straight at the games). Format:
# competition=url pairs, comma or newline separated. Grab a match URL from
# your browser's address bar (or via: python -m arb_tool --dump-bet365 --wait).
#BET365_MATCH_URLS=world_cup=https://www.bet365.nl/#/AC/B1/C1/D8/E197397308/F3/

# Kambi API overrides (only for UNIBET_PROVIDER=kambi); defaults usually work.
#KAMBI_BASE_URL=https://eu-offering-api.kambicdn.com/offering/v2018/ubnl
#KAMBI_LOCALE=nl_NL
#KAMBI_MARKET=NL
#KAMBI_PATH_PREMIER_LEAGUE=football/england/premier_league
#KAMBI_PATH_LA_LIGA=football/spain/la_liga
#KAMBI_PATH_WORLD_CUP=football/world_cup_2026
